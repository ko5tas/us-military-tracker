      <name>Vessels (3 tracked)</name>
      <Placemark>
        <name>USS John F. Kennedy (CVN-79)</name>
        <styleUrl>#vessel</styleUrl>
        <description>Branch: USN&#xA;Status: transit — Future Ford-class aircraft carrier departed Newport News Shipbuilding on Aug. 12, 2026, for acceptance trials, testing critical ship systems at sea.&#xA;Type: Aircraft Carrier Strike Group&#xA;Source: ai_intel</description>

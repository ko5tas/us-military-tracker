      <Placemark>
        <name>USS Theodore Roosevelt (CVN-71)</name>
        <styleUrl>#vessel</styleUrl>
        <description>Branch: USN&#xA;Status: deployed — Leading a group sail off Hawaii as part of RIMPAC 2026 exercises, demonstrating carrier strike group readiness in the Pacific.&#xA;Type: Aircraft Carrier Strike Group&#xA;Source: ai_intel</description>
